#!/usr/bin/env python

"""
This is a program for validating GeneLab pipeline processed amplicon datasets.
"""

import os
import sys
import argparse
import csv
import textwrap
import pandas as pd
import zipfile
from statistics import mean, median

parser = argparse.ArgumentParser(description = "This program validates a GeneLab pipeline processed amplicon dataset.  It is intended to \
                                             only be run after `GL-gen-processed-amplicon-readme` has been run successfully.")
required = parser.add_argument_group('required arguments')

required.add_argument("-g", "--GLDS-ID", help = 'GLDS ID (e.g. "GLDS-276")', action = "store", required = True)
required.add_argument("-r", "--runsheet", help = "A 3-column (single-end) or 4-column (paired-end) input file (sample_id, forward, [reverse,] paired) used to run the processing pipeline. \
                        This is the value set to the parameter --csv_file when run the processing pipeline with a csv file as input \
                        otherwise it is the GLfile.csv in the GeneLab directory if --GLDS_accession was used as input.", action = "store", required = True)
required.add_argument("--outdir", 
                      help="Directory of generated output files to be validated.", action="store", required=True)
parser.add_argument("--output", 
                    help = 'Name of output log file (default: "<GLDS-ID>_<output_prefix>amplicon-validation.log", with appended prefix if one is provided)',
                    default = "", action = "store")
parser.add_argument("-p", "--output-prefix", help = "Output additional file prefix if there is one", action = "store", default = "")
parser.add_argument("-l", "--V_V_guidelines_link", help = "Validation and verification guidelines link", action = "store", 
                    default = "https://github.com/nasa/GeneLab_AmpliconSeq_Workflow/blob/main/README.md")
parser.add_argument("--zip_targets", help = "A comma separated list of target files and/or directories to check in processing_info.zip",
                     action = "store", default = "Snakefile,config.yaml,envs/,logs/,scripts/,unique-sample-IDs.txt")
parser.add_argument("--assay_suffix", help = "Genelab assay suffix", action = "store", default = "_GLAmpSeq")
parser.add_argument("--raw_suffix", help = "Raw reads suffix", action = "store", default ="_raw.fastq.gz")
parser.add_argument("--raw_R1_suffix", help = "Raw forward reads suffix", action = "store", default = "_R1_raw.fastq.gz")
parser.add_argument("--raw_R2_suffix", help = "Raw reverse reads suffix", action = "store", default = "_R2_raw.fastq.gz")
parser.add_argument("--primer_trimmed_suffix", help = "Trimmed reads suffix", action = "store", default = "_trimmed.fastq.gz")
parser.add_argument("--primer_trimmed_R1_suffix", help = "Trimmed forward reads suffix", action = "store", default = "_R1_trimmed.fastq.gz")
parser.add_argument("--primer_trimmed_R2_suffix", help = "Trimmed reverse reads suffix", action = "store", default = "_R2_trimmed.fastq.gz")
parser.add_argument("--filtered_suffix", help = "Filtered reads suffix", action = "store", default = "_filtered.fastq.gz")
parser.add_argument("--filtered_R1_suffix", help = "Filtered forward reads suffix", action = "store", default = "_R1_filtered.fastq.gz")
parser.add_argument("--filtered_R2_suffix", help = "Filtered reverse reads suffix", action = "store", default = "_R2_filtered.fastq.gz")
parser.add_argument("--processing_zip_file", help = "Specifies the location of processing_info.zip", 
                    action = "store", default = "processing_info.zip")
parser.add_argument("--readme", help = "Specifies the location of README.txt", 
                    action = "store", default = "README.txt")
parser.add_argument("--single-ended", help = "Add this flag if data are single-end sequencing.", action = "store_true")
parser.add_argument("--primers-already-trimmed", help = "Add this flag if primers were trimmed prior to GeneLab processing, \
                    therefore there are no trimmed sequence data", action = "store_true")
parser.add_argument("--force-single-end", default=None,
                    help="If the data is paired-end but was processed as single-end, specify which read was used as single-end (R1 or R2)")
parser.add_argument("--include-raw-fastq", help="Add this flag if we should check existence of the raw fastq files, should not be set if force_single_end is used", action="store_true")
parser.add_argument("--diff-abund-method", choices=["all", "ancombc1", "ancombc2", "deseq2"], default="all",
                    help="Differential abundance method selected in the processing workflow.")

if len(sys.argv)==1:
    parser.print_help(sys.stderr)
    sys.exit(0)

args = parser.parse_args()


################################################################################

# Setting some colors
tty_colors = {
    'green' : '\033[0;32m%s\033[0m',
    'yellow' : '\033[0;33m%s\033[0m',
    'red' : '\033[0;31m%s\033[0m'
}


######################### Aesthetic functions ################################
def color_text(text, color='green'):
    if sys.stdout.isatty():
        return tty_colors[color] % text
    else:
        return text


def wprint(text):
    """ Print wrapper """

    print(textwrap.fill(text, width = 80, initial_indent="  ", 
          subsequent_indent="  ", break_on_hyphens=False))
    

def report_failure(validation_log,  message, color = "yellow", write_log = True):
    print("")
    wprint(color_text(message, color))
    print("\nValidation failed.\n")

    if write_log:
        with open(validation_log, "a") as log:
            log.write(message + "\n" + "Validation failed." + "\n\n")
    sys.exit(1)

######################### End of Aesthetic functions ################################


############ Main functions ##############

def setup_log(validation_log, V_V_guidelines_link):
    """ Writes validation log's header """

    with open(validation_log, "w") as log:
        log.write(f"Performing baseline Amplicon V+V as per: {V_V_guidelines_link}\n\n")
        command_run = " ".join(sys.argv)
        log.write(f"Validation program executed as:\n    {command_run}\n\n")


def append_message_to_log(validation_log, message, one_return = False):
    """ Appends line to validation log with one or two newline characters """

    with open(validation_log, "a") as log:
        if one_return:
            log.write(f"{message}\n")
        else:
            log.write(f"{message}\n\n")


def check_for_file_and_contents(validation_log, file_path):
    """ Used by various functions to check if a file exists and that it is not empty"""

    if not os.path.exists(file_path):
        report_failure(validation_log, "The expected file '" + str(file_path) + "' does not exist.")
    if not os.path.getsize(file_path) > 0:
        report_failure(validation_log, "The file '" + str(file_path) + "' is empty.")

def check_expected_directories(validation_log, expected_dirs):
    """ Checks that the expected directories exist """

    for directory in expected_dirs:
        if not os.path.isdir(directory):
            report_failure(validation_log, "The directory '" + str(directory) + "' was expected but not found.")

def read_samples(file_path):
    """ Getting sample names from runsheet and reading them into list """

    sample_names = []

    with open(file_path) as f:
        next(f)  # skip header line
        for line in f:
            sample_names.append(line.strip().split(",")[0])

    return sample_names

def check_multiqc_outputs(validation_log, sample_names, multiqc_zip, 
                          multiqc_stats_file_path, R1_suffix,
                          R2_suffix, unpaired_suffix, prefix, isSingle_ended, force_single_end):
    """ Makes sure all samples' read files are in the multiqc outputs """

    # Checking raw
    zip_file = zipfile.ZipFile(multiqc_zip)

    df = pd.read_csv(zip_file.open(multiqc_stats_file_path), sep = "\t", usecols = ["Sample"])

    file_prefixes_in_multiqc = df["Sample"].tolist()
    
    # If single-end
    if isSingle_ended:

        if force_single_end == "R1":
            suffix = R1_suffix.split(".")[0].replace(f"_{prefix}", "")
        elif force_single_end == "R2":
            suffix = R2_suffix.split(".")[0].replace(f"_{prefix}", "")
        else:
            suffix = unpaired_suffix.split(".")[0].replace(f"_{prefix}", "")

        for sample in sample_names:
            if not sample + suffix in file_prefixes_in_multiqc and not sample in file_prefixes_in_multiqc:
                report_failure(validation_log, f"The {prefix} multiqc output is missing the expected '" + \
                               sample + suffix + "' entry.")
    # If paired-end
    else:

        R1_suffix = R1_suffix.split(".")[0].replace(f"_{prefix}", "")
        R2_suffix = R2_suffix.split(".")[0].replace(f"_{prefix}", "")

        for sample in sample_names:
            if not sample + R1_suffix in file_prefixes_in_multiqc:
                report_failure(validation_log, f"The {prefix} multiqc output is missing the expected '" + \
                               sample + R1_suffix + "' entry.")
            if not sample + R2_suffix in file_prefixes_in_multiqc:
                report_failure(validation_log, f"The {prefix} multiqc output is missing the expected '" + \
                               sample + R2_suffix + "' entry.")

                
def check_fastq_files(validation_log, sample_names, reads_dir, 
                      unpaired_suffix, R1_suffix, R2_suffix, isSingle_ended, force_single_end):
    """ Makes sure all expected read fastq files exist and hold something """

    for sample in sample_names:
        ## If single-end
        if isSingle_ended:
            if force_single_end == "R1":
                check_for_file_and_contents(validation_log, os.path.join(reads_dir, sample + R1_suffix))
            elif force_single_end == "R2":
                check_for_file_and_contents(validation_log, os.path.join(reads_dir, sample + R2_suffix))
            else:
                check_for_file_and_contents(validation_log, os.path.join(reads_dir, sample + unpaired_suffix))
        ## If paired-end
        else:
            check_for_file_and_contents(validation_log, os.path.join(reads_dir, sample + R1_suffix))
            check_for_file_and_contents(validation_log, os.path.join(reads_dir, sample + R2_suffix))


def get_files_in_dir(dir_path):

    return([f for f in os.listdir(dir_path) if os.path.isfile(os.path.join(dir_path, f))])


def check_amplicon_intermediate_log_files(validation_log, reads_dir, expected_outputs_or_suffixes):

    output_files_present = get_files_in_dir(reads_dir)

    for entry in expected_outputs_or_suffixes:

        if not any(output_file.endswith(entry) for output_file in output_files_present):
            report_failure(validation_log, "An output file named or ending with '" + str(entry) + \
                           "' was expected but not found in " + str(reads_dir) + ".")

def check_general_fasta_format(validation_log, file_path):
    """ 
       Check that a fasta file is formatted properly i.e. 
       the number of headers equals the number of sequences
    """
    if not os.path.getsize(file_path) > 0:
        report_failure(validation_log, "The fasta file '" + str(file_path) + \
                       "' is empty but isn't expected to be.")

    line_num = 0
    num_headers = 0
    num_seqs = 0

    with open(file_path) as in_file:

        for line in in_file:

            # Keeping track of current line for reporting any problems
            line_num += 1

            if line.strip().startswith(">"):
                num_headers += 1
            else:
                num_seqs += 1

            if num_headers != num_seqs + 1 and num_headers != num_seqs:
                report_failure(validation_log, "Fasta file '" + str(file_path) + \
                               "' does not seem to be formatted properly. Problem detected at line " + \
                                str(line_num) + ".")


def check_amplicon_final_outputs(validation_log, final_outputs_dir, expected_final_outputs_or_suffixes):
    """ Makes sure outputs exist and checks formatting """

    # Getting list of files in output dir
    output_files_present = get_files_in_dir(final_outputs_dir)

    # Making sure none of them is absent and if present it is not empty
    for output_file in output_files_present:
        check_for_file_and_contents(validation_log, os.path.join(final_outputs_dir, output_file))

    # Checking all desired output types exist
    for entry in expected_final_outputs_or_suffixes:

        if not any(output_file.endswith(entry) for output_file in output_files_present):
            report_failure(validation_log, "An output file named or ending with '" + str(entry) + \
                           "' was expected but not found in " + str(final_outputs_dir) + ".")

    # Checking general fasta format is met
    fasta_files_in_output_dir = [output_file for output_file in output_files_present if output_file.endswith(".fasta")]

    for fasta_file in fasta_files_in_output_dir:
        check_general_fasta_format(validation_log, os.path.join(final_outputs_dir, fasta_file))


def check_for_failure_file(validation_log, directory, failure_filename):
    """
    Log and return the reason when a failure file exists.
    """
    failure_path = os.path.join(directory, failure_filename)
    if os.path.exists(failure_path):
        check_for_file_and_contents(validation_log, failure_path)
        with open(failure_path) as f:
            reason = f.read().strip()
        append_message_to_log(
            validation_log,
            f"    - WARNING: Analysis was skipped in {directory}. Reason:\n      {reason}"
        )
        return reason
    return None


def check_rarefaction_depth_consistency(validation_log, alpha_diversity_dir, beta_diversity_dir, output_prefix, assay_suffix):
    """ Check that rarefaction depth is consistent between alpha and beta diversity outputs """
    
    alpha_depth_file = os.path.join(alpha_diversity_dir, f"{output_prefix}rarefaction_depth{assay_suffix}.txt")
    beta_depth_file = os.path.join(beta_diversity_dir, f"{output_prefix}rarefaction_depth{assay_suffix}.txt")

    # Only check if both files exist (rarefaction ran in both)
    if not os.path.exists(alpha_depth_file) or not os.path.exists(beta_depth_file):
        append_message_to_log(validation_log, "    - Skipping rarefaction depth consistency check: depth file missing in one or both directories")
        return

    with open(alpha_depth_file) as f:
        alpha_depth = f.read().strip()
    with open(beta_depth_file) as f:
        beta_depth = f.read().strip()

    if alpha_depth != beta_depth:
        report_failure(
            validation_log,
            f"Rarefaction depth mismatch: alpha diversity used {alpha_depth} "
            f"but beta diversity used {beta_depth}."
        )
    
    append_message_to_log(
        validation_log,
        f"    - Rarefaction depth is consistent between alpha and beta diversity: {alpha_depth}"
    )


def count_da_comparisons(validation_log, results_file):
    """Count pairwise p-value columns in one method's differential abundance results."""
    try:
        with open(results_file, encoding="utf-8-sig", newline="") as f:
            header = next(csv.reader(f, strict=True), [])
    except (OSError, UnicodeError, csv.Error) as exc:
        report_failure(validation_log, f"Could not read differential abundance results header in '{results_file}': {exc}")

    comparisons = [column for column in header if column.startswith("P-value_(")]
    if (not comparisons or len(set(comparisons)) != len(comparisons)
            or any(")v(" not in column or not column.endswith(")") for column in comparisons)):
        report_failure(validation_log, f"Expected distinct P-value_(group)v(group) comparison columns in '{results_file}'.")
    return len(comparisons)


def check_volcano_plots(validation_log, da_dir, num_contrasts, output_prefix, assay_suffix):
    """Check the volcano plots for the selected run against its contrast count."""
    plot_prefix = f"{output_prefix}("
    plot_suffix = f"_volcano{assay_suffix}.png"
    plots = [
        entry.path for entry in os.scandir(da_dir)
        if entry.name.startswith(plot_prefix) and entry.name.endswith(plot_suffix) and entry.is_file()
    ]

    if len(plots) != num_contrasts:
        report_failure(
            validation_log,
            f"Expected {num_contrasts} volcano plots in '{da_dir}' "
            f"but found {len(plots)}."
        )
    for plot in plots:
        check_for_file_and_contents(validation_log, plot)
    append_message_to_log(
        validation_log,
        f"    - {len(plots)}/{num_contrasts} expected volcano plots found in {da_dir}"
    )


def check_amplicon_processing_zip(validation_log, processing_zip_file, expected_zip_contents):
    """ This just makes sure a processing zip exists along with its expected content """

    check_for_file_and_contents(validation_log, processing_zip_file)

    with zipfile.ZipFile(processing_zip_file) as zip_obj:

        entries = zip_obj.namelist()

    ROOT_DIR = entries[0]

    for item in expected_zip_contents:
        if ROOT_DIR + item not in entries:
            report_failure(validation_log, "The '" + str(processing_zip_file) + \
                           "' does not have '" + str(item) + "' as expected.")


def report_success(validation_log):
    print("")
    wprint(color_text("Validation has completed successfully :)", "green"))
    print(f"\n  Log written to: '{validation_log}'\n")

    with open(validation_log, "a") as log:

        log.write("   -----------------------------------------------------------------------------\n")
        log.write("                         Validation completed successfully." + "\n")
        log.write("   -----------------------------------------------------------------------------\n")

def gen_stats(list_of_ints):

    """ Returns min, max, mean, median of input integer list """

    min_val = min(list_of_ints)
    max_val = max(list_of_ints)

    mean_val = round(mean(list_of_ints), 2)
    median_val = int(median(list_of_ints))
    
    return(min_val, max_val, mean_val, median_val)


def get_read_count_stats(validation_log, prefix, multiqc_zip, multiqc_stats_file_path):
    
    """ Grabs read counts and summarizes """

    zip_file = zipfile.ZipFile(multiqc_zip)
    #read_count_column = 6
    #df = pd.read_csv(zip_file.open(multiqc_stats_file_path), sep = "\t", usecols = [read_count_column])
    df = pd.read_csv(zip_file.open(multiqc_stats_file_path), sep = "\t")
    df = df.iloc[:,[-1]] # retrieve the last column which is reads counts column

    # Test to see if the sequence counts are presented as raw counts 
    # or as decimal representation of a million 
    max_count = df.iloc[:,0].max()
    if not isinstance(max_count, int):
        df = df * 1000000  # convert to raw counts

    df.columns = ["counts"]
    counts = df.counts.tolist()

    # Getting rid of decimals
    counts = [ int(round(i, 0)) for i in counts ]

    Min, Max, Mean, Median = gen_stats(counts)


    print(f"\n  {prefix.title()} read count summary:")
    print("    {:<10} {:>0}".format("Min:", Min))
    print("    {:<10} {:>0}".format("Max:", Max))
    print("    {:<10} {:>0}".format("Mean:", Mean))
    print("    {:<10} {:>0}".format("Median:", Median))

    with open(validation_log, "a") as log:

        log.write(f"\n  {prefix.title()} read count summary:")
        log.write("\n    {:<10} {:>0}".format("Min:", Min))
        log.write("\n    {:<10} {:>0}".format("Max:", Max))
        log.write("\n    {:<10} {:>0}".format("Mean:", Mean))
        log.write("\n    {:<10} {:>0}".format("Median:", Median))


def main():

    ### Variable setup ###
    V_V_guidelines_link = str(args.V_V_guidelines_link)

    assay_suffix = str(args.assay_suffix)
    output_prefix = str(args.output_prefix)

    # top level folders
    raw_reads_dir = f"{args.outdir}/Raw_Sequence_Data"
    trimmed_reads_dir = f"{args.outdir}/Trimmed_Sequence_Data"
    filtered_reads_dir = f"{args.outdir}/Filtered_Sequence_Data"
    final_outputs_dir = f"{args.outdir}/Final_Outputs"

    # MultiQC_Reports subfolders
    raw_multiqc_dir = f"{raw_reads_dir}/MultiQC_Reports"
    filtered_multiqc_dir = f"{filtered_reads_dir}/MultiQC_Reports"

    # Final_Outputs/ subfolders
    alpha_diversity_dir = f"{final_outputs_dir}/alpha_diversity"
    beta_diversity_dir = f"{final_outputs_dir}/beta_diversity"
    taxonomy_plots_dir = f"{final_outputs_dir}/taxonomy_plots"
    differential_abundance_dir = f"{final_outputs_dir}/differential_abundance"
    
    # filename definitions and paths
    processing_zip_file = str(args.processing_zip_file)
    raw_multiqc_zip = f"raw_multiqc{assay_suffix}_data.zip"
    filtered_multiqc_zip = f"filtered_multiqc{assay_suffix}_data.zip"
    raw_multiqc_stats_file_path = f"raw_multiqc{assay_suffix}_data/multiqc_general_stats.txt"
    filtered_multiqc_stats_file_path = f"filtered_multiqc{assay_suffix}_data/multiqc_general_stats.txt"
    contrasts_file = f"{differential_abundance_dir}/" + str(output_prefix) + f"contrasts{assay_suffix}.csv"

    if args.force_single_end:
        args.single_ended = True
        if args.include_raw_fastq:
            print("Warning: --include-raw-fastq should not be set when --force-single-end is used. Ignoring --include-raw-fastq flag.")
            args.include_raw_fastq = False

    raw_suffix = str(args.raw_suffix)
    raw_R1_suffix = str(args.raw_R1_suffix)
    raw_R2_suffix = str(args.raw_R2_suffix)

    primer_trimmed_suffix = str(args.primer_trimmed_suffix)
    primer_trimmed_R1_suffix = str(args.primer_trimmed_R1_suffix)
    primer_trimmed_R2_suffix = str(args.primer_trimmed_R2_suffix)
    filtered_suffix = str(args.filtered_suffix)
    filtered_R1_suffix = str(args.filtered_R1_suffix)
    filtered_R2_suffix = str(args.filtered_R2_suffix)

    # expected file types in each folder and subfolder
    expected_trimmed_outputs_or_suffixes = [output_prefix + f"cutadapt{assay_suffix}.log",
                                             output_prefix + f"trimmed-read-counts{assay_suffix}.tsv"]
    expected_filtered_outputs_or_suffixes = [f"filtered-read-counts{assay_suffix}.tsv"]
    expected_final_outputs_or_suffixes = [".fasta", output_prefix + f"counts{assay_suffix}.tsv",
                                           output_prefix + f"taxonomy{assay_suffix}.tsv",
                                           ".biom.zip", 
                                           output_prefix + f"taxonomy-and-counts{assay_suffix}.tsv",
                                           output_prefix + f"read-count-tracking{assay_suffix}.tsv"]
    expected_alpha_diversity_outputs_or_suffixes = [output_prefix + f"alpha_diversity_plots{assay_suffix}.zip",
                                                    output_prefix + f"statistics_table{assay_suffix}.csv",
                                                    output_prefix + f"summary_table{assay_suffix}.csv",
                                                    output_prefix + f"rarefaction_curves{assay_suffix}.png",
                                                    output_prefix + f"richness_and_diversity_estimates_by_group{assay_suffix}.png",
                                                    output_prefix + f"richness_and_diversity_estimates_by_sample{assay_suffix}.png",
                                                    output_prefix + f"rarefaction_depth{assay_suffix}.txt"]

    expected_beta_diversity_outputs_or_suffixes = [output_prefix + f"bray_curtis_plots{assay_suffix}.zip",
                                                   output_prefix + f"bray_adonis_table{assay_suffix}.csv",
                                                   output_prefix + f"bray_variance_table{assay_suffix}.csv",
                                                   output_prefix + f"bray_dendrogram{assay_suffix}.png",
                                                   output_prefix + f"bray_PCoA_w_labels{assay_suffix}.png",
                                                   output_prefix + f"bray_PCoA_without_labels{assay_suffix}.png",
                                                   output_prefix + f"euclidean_distance_plots{assay_suffix}.zip",
                                                   output_prefix + f"euclidean_adonis_table{assay_suffix}.csv",
                                                   output_prefix + f"euclidean_variance_table{assay_suffix}.csv",
                                                   output_prefix + f"euclidean_dendrogram{assay_suffix}.png",
                                                   output_prefix + f"euclidean_PCoA_w_labels{assay_suffix}.png",
                                                   output_prefix + f"euclidean_PCoA_without_labels{assay_suffix}.png",
                                                   output_prefix + f"vsd_validation_plot{assay_suffix}.png",
                                                   output_prefix + f"rarefaction_depth{assay_suffix}.txt"]

    expected_taxonomy_plots_outputs_or_suffixes = [output_prefix + f"group_taxonomy_plots{assay_suffix}.zip",
                                                   output_prefix + f"groups_class{assay_suffix}.png",
                                                   output_prefix + f"groups_family{assay_suffix}.png",
                                                   output_prefix + f"groups_genus{assay_suffix}.png",
                                                   output_prefix + f"groups_order{assay_suffix}.png",
                                                   output_prefix + f"groups_phylum{assay_suffix}.png",
                                                   output_prefix + f"groups_species{assay_suffix}.png",
                                                   output_prefix + f"sample_taxonomy_plots{assay_suffix}.zip",
                                                   output_prefix + f"samples_class{assay_suffix}.png",
                                                   output_prefix + f"samples_family{assay_suffix}.png",
                                                   output_prefix + f"samples_genus{assay_suffix}.png",
                                                   output_prefix + f"samples_order{assay_suffix}.png",
                                                   output_prefix + f"samples_phylum{assay_suffix}.png",
                                                   output_prefix + f"samples_species{assay_suffix}.png"]

    da_methods = ["ancombc1", "ancombc2", "deseq2"] if args.diff_abund_method == "all" else [args.diff_abund_method]
    da_method_dirs = {method: f"{differential_abundance_dir}/{method}" for method in da_methods}

    # expected directories to check
    expected_dirs = [filtered_reads_dir, filtered_multiqc_dir, final_outputs_dir,
                     alpha_diversity_dir, beta_diversity_dir, taxonomy_plots_dir, 
                     differential_abundance_dir, *da_method_dirs.values()]

    if args.include_raw_fastq:
        expected_dirs.append(raw_reads_dir)
        expected_dirs.append(raw_multiqc_dir)

    if not args.primers_already_trimmed:
        expected_dirs.append(trimmed_reads_dir)

    if args.output == "":
        validation_log = str(args.GLDS_ID) + "_" + output_prefix + "amplicon-validation.log"
    else:
        validation_log = str(args.output)


    # Initializing the log file
    setup_log(validation_log, V_V_guidelines_link)
    append_message_to_log(validation_log, f"Summary of checks:")

    # Check if README.txt exists
    check_for_file_and_contents(validation_log, args.readme)
    append_message_to_log(validation_log, f"    - populated {args.readme} detected")
    # Check if the expected directories exist
    check_expected_directories(validation_log, expected_dirs)
    # Retrieve unique sample names from the sample IDs file
    sample_names = read_samples(args.runsheet)

    # Raw reads
    # Collect raw read-count statistics when the raw MultiQC report is present.
    # since we still want to check the raw multiqc outputs and get read count stats from it even if we aren't checking for the raw fastq files themselves.
    raw_multiqc_zip = os.path.join(raw_multiqc_dir, raw_multiqc_zip)
    raw_prefix = "raw"
    if args.include_raw_fastq:
        check_fastq_files(validation_log, sample_names, raw_reads_dir, 
                          raw_suffix, raw_R1_suffix, raw_R2_suffix, args.single_ended, args.force_single_end)
        append_message_to_log(validation_log, f"    - all expected fastq read files were found in {raw_reads_dir}")
        # Check raw multiqc outputs
        check_multiqc_outputs(validation_log, sample_names, raw_multiqc_zip, 
                            raw_multiqc_stats_file_path, raw_R1_suffix,
                            raw_R2_suffix, raw_suffix, raw_prefix, args.single_ended, args.force_single_end)
        append_message_to_log(validation_log, f"    - all expected samples were found in raw multiqc files in {raw_multiqc_dir}")

    # Trimmed reads
    if not args.primers_already_trimmed:
        check_fastq_files(validation_log, sample_names, trimmed_reads_dir, 
                          primer_trimmed_suffix, primer_trimmed_R1_suffix,
                          primer_trimmed_R2_suffix, args.single_ended, args.force_single_end)
        append_message_to_log(validation_log, f"    - all expected fastq read files were found in {trimmed_reads_dir}")
        check_amplicon_intermediate_log_files(validation_log, trimmed_reads_dir,
                                               expected_trimmed_outputs_or_suffixes)
        for file in expected_trimmed_outputs_or_suffixes:
            append_message_to_log(validation_log, f"    - {file} was found in {trimmed_reads_dir}")
        append_message_to_log(validation_log, f"    - all expected files were found in {trimmed_reads_dir}")

    # Filtered reads
    check_fastq_files(validation_log, sample_names, filtered_reads_dir, 
                      filtered_suffix, filtered_R1_suffix, 
                      filtered_R2_suffix, args.single_ended, args.force_single_end)
    append_message_to_log(validation_log, f"    - all expected fastq read files were found in {filtered_reads_dir}")
    check_amplicon_intermediate_log_files(validation_log, filtered_reads_dir,
                                           expected_filtered_outputs_or_suffixes)
    for file in expected_filtered_outputs_or_suffixes:
        append_message_to_log(validation_log, f"    - {file} was found in {filtered_reads_dir}")
    append_message_to_log(validation_log, f"    - all expected files were found in the {filtered_reads_dir} directory")
    # Check filtered multiqc outputs
    filtered_multiqc_zip = os.path.join(filtered_multiqc_dir, filtered_multiqc_zip)
    filtered_prefix = "filtered"   
    check_multiqc_outputs(validation_log, sample_names, filtered_multiqc_zip,
                          filtered_multiqc_stats_file_path, filtered_R1_suffix, 
                          filtered_R2_suffix, filtered_suffix, filtered_prefix, args.single_ended, args.force_single_end)
    append_message_to_log(validation_log, f"    - all expected samples were found in filtered multiqc files in {filtered_multiqc_dir}")

    # Check that all expected individual files exist in the final outputs directory and that the fasta files are rightly formatted 
    # i.e., the number of sequence headers equals the number of sequences in the fasta file.
    check_amplicon_final_outputs(validation_log, final_outputs_dir, expected_final_outputs_or_suffixes)
    for file in expected_final_outputs_or_suffixes:
        if file.startswith("."):
            append_message_to_log(validation_log, f"    - *{file} was found in {final_outputs_dir}")
        else: 
            append_message_to_log(validation_log, f"    - {file} was found in {final_outputs_dir}") 
    append_message_to_log(validation_log, f"    - all expected individual files were found in the {final_outputs_dir} directory")

    # Alpha diversity outputs
    alpha_failure_file = f"{output_prefix}alpha_diversity_failure{assay_suffix}.txt"
    alpha_failure = check_for_failure_file(validation_log, alpha_diversity_dir, alpha_failure_file)
    if alpha_failure is not None:
        append_message_to_log(validation_log, f"    - Skipping alpha diversity validation due to failure file")
    else:
        check_amplicon_final_outputs(validation_log, alpha_diversity_dir, expected_alpha_diversity_outputs_or_suffixes)
        append_message_to_log(validation_log, f"    - all expected files were found in {alpha_diversity_dir}")

    # Beta diversity outputs
    beta_failure_file = f"{output_prefix}beta_diversity_failure{assay_suffix}.txt"
    beta_failure = check_for_failure_file(validation_log, beta_diversity_dir, beta_failure_file)
    vsd_plot = f"{output_prefix}vsd_validation_plot{assay_suffix}.png"
    euclidean_dendrogram = f"{output_prefix}euclidean_dendrogram{assay_suffix}.png"
    if beta_failure is None:
        check_amplicon_final_outputs(validation_log, beta_diversity_dir, expected_beta_diversity_outputs_or_suffixes)
        append_message_to_log(validation_log, f"    - all expected files were found in {beta_diversity_dir}")
    elif "beta diversity group comparisons cannot be performed" in beta_failure:
        check_amplicon_final_outputs(validation_log, beta_diversity_dir, [vsd_plot, euclidean_dendrogram])
        append_message_to_log(validation_log, "    - VST diagnostic and Euclidean dendrogram found; skipping group statistics and PCoA")
    else:
        # VST outputs may still exist even if rarefaction failed
        vsd_path = os.path.join(beta_diversity_dir, vsd_plot)
        if os.path.exists(vsd_path):
            append_message_to_log(validation_log, "    - Rarefaction failed but VST outputs detected, validating VST outputs only")
            vst_only_outputs = [
                f"{output_prefix}euclidean_adonis_table{assay_suffix}.csv",
                f"{output_prefix}euclidean_variance_table{assay_suffix}.csv",
                euclidean_dendrogram,
                f"{output_prefix}euclidean_PCoA_w_labels{assay_suffix}.png",
                f"{output_prefix}euclidean_PCoA_without_labels{assay_suffix}.png",
                vsd_plot
            ]
            check_amplicon_final_outputs(validation_log, beta_diversity_dir, vst_only_outputs)
            append_message_to_log(validation_log, f"    - expected VST outputs were found in {beta_diversity_dir}")
        else:
            append_message_to_log(validation_log, "    - Skipping beta diversity validation, both rarefaction and VST failed")
    # If both alpha and beta diversity outputs are present, check that rarefaction depth is consistent between them
    if beta_failure is None and alpha_failure is None:
        check_rarefaction_depth_consistency(validation_log, alpha_diversity_dir, beta_diversity_dir, output_prefix, assay_suffix)

    # Taxonomy plots outputs
    check_amplicon_final_outputs(validation_log, taxonomy_plots_dir, expected_taxonomy_plots_outputs_or_suffixes)
    append_message_to_log(validation_log, f"    - all expected files were found in {taxonomy_plots_dir}")

    # Each method can publish a failure record instead of differential abundance results.
    completed_da_methods = {}
    for method, method_dir in da_method_dirs.items():
        failure_filename = f"{output_prefix}{method}_failure{assay_suffix}.txt"
        if check_for_failure_file(validation_log, method_dir, failure_filename) is None:
            completed_da_methods[method] = os.path.join(
                method_dir, f"{output_prefix}{method}_differential_abundance{assay_suffix}.csv"
            )

    check_amplicon_final_outputs(validation_log, differential_abundance_dir, [f"{output_prefix}SampleTable{assay_suffix}.csv"])
    if completed_da_methods:
        check_for_file_and_contents(validation_log, contrasts_file)
    append_message_to_log(validation_log, f"    - all expected individual files were found in {differential_abundance_dir}")

    for method, results_file in completed_da_methods.items():
        method_dir = da_method_dirs[method]
        expected_outputs = [os.path.basename(results_file), f"{output_prefix}{method}_volcano_plots{assay_suffix}.zip"]
        if method == "deseq2":
            expected_outputs.append(f"{output_prefix}asv_sparsity_plot{assay_suffix}.png")
        check_amplicon_final_outputs(validation_log, method_dir, expected_outputs)
        num_contrasts = count_da_comparisons(validation_log, results_file)
        check_volcano_plots(validation_log, method_dir, num_contrasts, output_prefix, assay_suffix)
        append_message_to_log(validation_log, f"    - all expected files were found in {method_dir}")

    # Checking for processing_info.zip
    check_for_file_and_contents(validation_log, processing_zip_file)
    append_message_to_log(validation_log, f"    - populated {processing_zip_file} detected")

    # Check that the procesing_info.zip file contains the target sequence 
    expected_zip_contents = str(args.zip_targets).split(",")
    check_amplicon_processing_zip(validation_log, processing_zip_file, expected_zip_contents)
    for file in expected_zip_contents:
        append_message_to_log(validation_log, f"    - {file} was found in {processing_zip_file}")

    if os.path.isfile(raw_multiqc_zip):
        get_read_count_stats(validation_log, raw_prefix, raw_multiqc_zip, raw_multiqc_stats_file_path)
    get_read_count_stats(validation_log, filtered_prefix, filtered_multiqc_zip, filtered_multiqc_stats_file_path)
    report_success(validation_log)

if __name__ == "__main__":
    main()
